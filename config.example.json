{
  "mode": "paper",
  "database": "data/memetrader_forward.sqlite3",
  "lock_file": "data/memetrader.lock",
  "poll_seconds": 60,
  "reverse_news_seconds": 45,
  "event_scan_seconds": 10,
  "position_scan_seconds": 15,
  "source_health_seconds": 30,
  "event_min_attention": 50,
  "sources": {
    "rss": [
      {
        "name": "coindesk",
        "url": "https://www.coindesk.com/arc/outboundfeeds/rss/",
        "kind": "news",
        "enabled": true
      },
      {
        "name": "cointelegraph",
        "url": "https://cointelegraph.com/rss",
        "kind": "news",
        "enabled": true
      },
      {
        "name": "google-news-viral",
        "url": "https://news.google.com/rss/search?q=%28%22goes+viral%22+OR+%22internet+reacts%22+OR+%22social+media+erupts%22+OR+%22viral+animal%22+OR+%22viral+meme%22%29+when%3A1h&hl=en-US&gl=US&ceid=US%3Aen",
        "kind": "news",
        "enabled": true
      },
      {
        "name": "google-news-memecoin",
        "url": "https://news.google.com/rss/search?q=%28memecoin+OR+%22meme+coin%22+OR+pump.fun%29+when%3A1h&hl=en-US&gl=US&ceid=US%3Aen",
        "kind": "news",
        "enabled": true
      }
    ],
    "bluesky_queries": ["memecoin", "pump.fun", "viral animal"],
    "mastodon": [],
    "gecko_networks": ["solana", "bsc"],
    "pumpportal": {
      "enabled": true,
      "url": "wss://pumpportal.fun/api/data"
    },
    "reverse_google_news": {
      "enabled": true,
      "queries_per_cycle": 3,
      "cooldown_minutes": 15,
      "max_results_per_query": 8,
      "max_result_age_minutes": 180,
      "min_independent_sources": 2
    }
  },
  "bridge": {
    "enabled": true,
    "host": "127.0.0.1",
    "port": 8765,
    "token": "RUN_INIT_TO_GENERATE_A_PRIVATE_TOKEN",
    "max_body_bytes": 262144
  },
  "events": {
    "max_source_age_minutes": 30,
    "cluster_hours": 8,
    "similarity": 0.28
  },
  "candidate": {
    "chains": ["solana", "bsc", "base"],
    "max_alias_queries": 4,
    "token_watch_minutes": 360,
    "min_candidate_score": 67,
    "min_match_score": 52,
    "min_canonical_margin": 5,
    "agent_tie_threshold": 3,
    "decision_cooldown_seconds": 180,
    "retry_seconds": [25, 60, 150, 300],
    "max_events_per_cycle": 8,
    "max_source_age_minutes": 30,
    "allow_reentry": false,
    "min_reverse_independent_sources": 2,
    "reverse_only_penalty": 8
  },
  "safety": {
    "min_liquidity_usd": 12000,
    "max_market_cap_usd": 25000000,
    "min_5m_transactions": 8,
    "min_buy_ratio": 0.55,
    "honeypot_is": true,
    "require_evm_simulation": false,
    "max_tax_pct": 12,
    "rugcheck": true,
    "require_solana_report": false,
    "max_solana_risk_score": 79
  },
  "paper": {
    "starting_cash_usd": 1000,
    "fee_bps": 60,
    "slippage_rate": 0.02,
    "risk_per_trade_pct": 0.005,
    "max_position_usd": 35,
    "min_position_usd": 3,
    "max_cash_fraction": 0.08,
    "max_liquidity_impact_pct": 0.0025,
    "max_daily_new_exposure_usd": 100,
    "max_open_positions": 3,
    "stop_loss_pct": -0.35,
    "trailing_activate_pct": 0.6,
    "trailing_drawdown_pct": 0.28,
    "emergency_liquidity_usd": 3000,
    "max_holding_hours": 24,
    "take_profit_tiers": [
      {"return_pct": 0.8, "sell_fraction": 0.2},
      {"return_pct": 1.8, "sell_fraction": 0.25},
      {"return_pct": 3.5, "sell_fraction": 0.35},
      {"return_pct": 7.0, "sell_fraction": 1.0}
    ]
  },
  "agent": {
    "enabled": false,
    "provider": "codex",
    "codex_path": "codex",
    "daily_limits": {"low": 8, "medium": 3, "high": 0},
    "models": {"low": "", "medium": ""},
    "reasoning_effort": {"low": "low", "medium": "medium"},
    "timeout_seconds": 90
  },
  "notifications": {
    "jsonl": "data/notifications.jsonl",
    "ntfy_url": "",
    "telegram_bot_token": "",
    "telegram_chat_id": ""
  },
  "source_stale_minutes": {"browser": 3, "other": 20},
  "live": {"enabled": false}
}
